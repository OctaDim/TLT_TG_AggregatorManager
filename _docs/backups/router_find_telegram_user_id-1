from pprint import pprint

from fastapi import APIRouter, HTTPException
from httpx import request
from sqlalchemy.testing.config import requirements
from starlette import status
from starlette.responses import JSONResponse
from telethon import functions, types

from configs.console_colors import CONSOLE_COLORS
from configs.settings import API_OPTIONS
from fast_api.app_auth.funcs_auth import (
    verify_auth_username_password)
from fast_api.app_auth.scheme_auth import (
    AuthData)
from fast_api.app_find_telegram_user_id.scheme_find_telegram_user_id import (
    InFindTelegramUserData)
from fast_api.app_web_account.scheme_web_account import (
    InWebAccountData)
from telethon_manager.telethon_clients_manager import (
    TelethonManagerSingleton)

base_url_name = API_OPTIONS.API_BASE_URL_NAME
rtr_find_telegram_user_id = APIRouter(prefix=f"/{base_url_name}",
                                      tags=["TELEGRAM TLT ENDPOINTS"])


@rtr_find_telegram_user_id.post("/find_telegram_user_data")
async def find_telegram_users_data_router(
        auth_data: AuthData,
        web_account_data: InWebAccountData,
        user_data: InFindTelegramUserData
) -> JSONResponse:
    await verify_auth_username_password(
        username=auth_data.username,
        password=auth_data.password)

    web_account_id = web_account_data.web_account_id
    web_account_username = web_account_data.web_account_username
    # telegram_phone = web_account_data.telegram_phone
    # bot_token = web_account_data.telegram_bot_token
    # bot_token_info = bot_token[:10] if bot_token else None
    config_partly_name = f"_{web_account_id}_{web_account_username}"

    tg_first_name = user_data.tg_first_name
    tg_last_name = user_data.tg_last_name
    tg_phone = user_data.tg_phone

    try:
        telethon_manager = TelethonManagerSingleton()  # Singleton
        tlt_manager_clients = telethon_manager.clients
        account_only_clients = {}
        for cur_config_name, cur_tlt_client in tlt_manager_clients.items():
            if config_partly_name in cur_config_name:
                account_only_clients[config_partly_name] = cur_tlt_client

        for cur_config_name, cur_tlt_client in account_only_clients.items():
            user_obj = None
            try:
                user_obj = await cur_tlt_client.get_entity(tg_phone)
                print(f"111 @@@@@@@@@@@@ user_obj", user_obj)
                print("@@@@@@@@@ user_obj.id", user_obj.id)
                print("@@@@@@@@@ user_obj.first_name", user_obj.first_name)
                print("@@@@@@@@@ user_obj.last_name", user_obj.last_name)
                print("@@@@@@@@@ user_obj.phone", user_obj.phone)
                print()
            except Exception as error:
                print(f"111 @@@@@@@@@@@@ get_entity(tg_phone) [ERROR]: error: {error}")
            print()

            user_obj = None
            if not user_obj:
                try:
                    contact = types.InputPhoneContact(
                        client_id=0,  # можно 0 или любое число
                        phone=tg_phone,
                        first_name=tg_first_name or "",
                        last_name=tg_last_name or "")

                    req_result = await cur_tlt_client(functions.contacts.ImportContactsRequest([contact]))
                    print(f"444 @@@@@@@@@ req_result", req_result)
                    user_obj = req_result.users[0]
                    print("@@@@@@@@@ user_obj.id", user_obj.id)
                    print("@@@@@@@@@ user_obj.first_name", user_obj.first_name)
                    print("@@@@@@@@@ user_obj.last_name", user_obj.last_name)
                    print("@@@@@@@@@ user_obj.phone", user_obj.phone)
                    print()
                    await cur_tlt_client(functions.contacts.DeleteContactsRequest([user_obj]))
                except Exception as error:
                    print(f"444 @@@@@@@@@ get_input_entity(tg_phone) [ERROR]: error: {error}")
                print()

            user_obj = None
            if not user_obj:
                try:
                    user_link = await cur_tlt_client.get_input_entity(tg_phone)
                    user_obj = await cur_tlt_client.get_entity(user_link)
                    print(f"222 @@@@@@@@@ user_obj", user_obj)
                    print("@@@@@@@@@ user_obj.id", user_obj.id)
                    print("@@@@@@@@@ user_obj.first_name", user_obj.first_name)
                    print("@@@@@@@@@ user_obj.last_name", user_obj.last_name)
                    print("@@@@@@@@@ user_obj.phone", user_obj.phone)
                    print()
                except Exception as error:
                    print(f"222 @@@@@@@@@ get_input_entity(tg_phone) [ERROR]: error: {error}")
                print()

            user_obj = None
            if not user_obj:
                if tg_first_name and tg_last_name:
                    name_search_str = f"{tg_first_name} {tg_last_name}"
                else:
                    name_search_str = tg_first_name or tg_last_name

                if name_search_str:
                    req_result = await cur_tlt_client(
                        functions.contacts.SearchRequest(q=name_search_str, limit=1000))
                    print(f"333 @@@@@@@@@ req_result.users", req_result.users)

                    matched_users = {}
                    for cur_user in req_result.users:
                        # real_user_flag = all([
                        #     isinstance(cur_user, types.User),
                        #     cur_user.bot,
                        #     not cur_user.deleted])

                        if (isinstance(cur_user, types.User) and not cur_user.bot
                                and not cur_user.deleted):
                            print("333 @@@@@@@@@ cur_user", cur_user)
                            print("@@@@@@@@@ cur_user.id", cur_user.id)
                            print("@@@@@@@@@ cur_user.first_name", cur_user.first_name)
                            print("@@@@@@@@@ cur_user.last_name", cur_user.last_name)
                            print("@@@@@@@@@ cur_user.phone", cur_user.phone)
                            print()

                            cur_first_name = (cur_user.first_name or "").lower()
                            cur_last_name = (cur_user.last_name or "").lower()
                            cur_phone = cur_user.phone or ""
                            name_match_flag = all([
                                tg_first_name.lower() in cur_first_name,
                                tg_last_name.lower() in cur_last_name,
                                tg_phone in cur_phone])
                            print("@@@@@@@@@ tg_first_name.lower()", tg_first_name.lower())
                            print("@@@@@@@@@ cur_first_name", cur_first_name)
                            print("@@@@@@@@@ tg_last_name.lower()", tg_last_name.lower())
                            print("@@@@@@@@@ cur_last_name", cur_last_name)
                            print("@@@@@@@@@ tg_phone", tg_phone)
                            print("@@@@@@@@@ cur_phone", cur_phone)

                            print("@@@@@@@@@ name_match_flag", name_match_flag)

                            if name_match_flag:
                                cur_user_data = {
                                    "id": cur_user.id,
                                    "first_name": cur_user.first_name,
                                    "last_name": cur_user.last_name,
                                    "phone": cur_user.phone}
                                matched_users[cur_user.id] = cur_user_data
                    print("@@@@@@@@@ matched_users", matched_users)
                    # pprint(object=matched_users)
                    print()
                    print()
        json_response = JSONResponse(
            content={"message": "Telethon user found [OK]",
                     "username": auth_data.username,
                     # "cur_config_name": cur_config_name,
                     # "running_async_tasks": running_async_tasks,
                     # "event_handlers": event_handlers,
                     # "running_state": running_state
                     },
            status_code=status.HTTP_200_OK)

        blue_clr = CONSOLE_COLORS.BRIGHT_BLUE
        yellow_clr = CONSOLE_COLORS.BRIGHT_YELLOW
        green_clr = CONSOLE_COLORS.BRIGHT_GREEN
        reset_clr = CONSOLE_COLORS.RESET
        print(f"Response.body: {json_response.body}\n"
              f"Response.status_code: {json_response.status_code}\n"
              f"username: {auth_data.username}\n"
              f"tlt_manager_clients: {blue_clr}{tlt_manager_clients}{reset_clr}\n"
              # f"running_async_tasks: {yellow_clr}{running_async_tasks}{reset_clr}\n"
              # f"event_handlers: {green_clr}{event_handlers}{reset_clr}\n"
              # f"running_state: {running_state}\n"
              )
        return json_response
    except Exception as error:
        log_text = (f"Router Find telegram user id [ERROR]: "
                    f"error: {error}")
        print(log_text)
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=log_text)
